{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "reclaim-disk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "reclaim-disk": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxlint": "1.83.0",
    "prettier": "3.9.7",
    "typescript": "5.9.2"
  }
}
